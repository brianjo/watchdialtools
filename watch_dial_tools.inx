      <param name="wd_font_custom" type="string" gui-text="Custom font family (exact name)"> </param>
      <param name="wd_font_size_mm" type="float" min="0.2" max="10" precision="2" gui-text="Font size (mm)">2.6</param>
      <param name="wd_text_baseline" type="optiongroup" appearance="combo" gui-text="Text baseline">
        <option value="optical" default="true">optical center (best for numbers)</option>
        <option value="central">central</option>
        <option value="middle">middle</option>
        <option value="alphabetic">alphabetic</option>
        <option value="hanging">hanging</option>
      </param>
      <param name="wd_number_orientation" type="optiongroup" appearance="combo" gui-text="Number orientation">
        <option value="upright">upright</option>
        <option value="tangent">tangent</option>
        <option value="radial">radial</option>
        <option value="tangent_readable">tangent_readable</option>
      </param>
      <separator/>
      <label appearance="header">Hour markers &amp; minute ticks</label>
      <param name="wd_show_hour_markers" type="bool" gui-text="Show hour markers">true</param>
      <param name="wd_hour_marker_radius_mm" type="float" min="0" max="60" precision="2" gui-text="Hour marker radius (mm)">12.8</param>
      <param name="wd_hour_marker_w_mm" type="float" min="0.01" max="10" precision="2" gui-text="Hour marker width (mm)">0.7</param>
      <param name="wd_hour_marker_h_mm" type="float" min="0.01" max="20" precision="2" gui-text="Hour marker height (mm)">1.8</param>
      <param name="wd_hour_marker_align" type="optiongroup" appearance="combo" gui-text="Hour marker align">
        <option value="outer">outer</option>
        <option value="center">center</option>
        <option value="inner">inner</option>
      </param>
      <separator/>
      <param name="wd_show_minute_ticks" type="bool" gui-text="Show minute ticks">true</param>
      <param name="wd_minute_tick_radius_mm" type="float" min="0" max="60" precision="2" gui-text="Minute tick radius (mm)">13.6</param>
      <param name="wd_minute_tick_w_mm" type="float" min="0.01" max="10" precision="2" gui-text="Minute tick width (mm)">0.25</param>
      <param name="wd_minute_tick_h_mm" type="float" min="0.01" max="20" precision="2" gui-text="Minute tick height (mm)">1.0</param>
      <param name="wd_five_minute_scale" type="float" min="1" max="10" precision="2" gui-text="5-minute tick scale">1.7</param>
      <param name="wd_minute_tick_align" type="optiongroup" appearance="combo" gui-text="Minute tick align">
        <option value="outer">outer</option>
        <option value="center">center</option>
        <option value="inner">inner</option>
      </param>
      </vbox>
      </hbox>
    </page>

    <!-- ========================= BLANK TEMPLATE ========================= -->
    <page name="blank" gui-text="Blank Template">
      <label appearance="header">Movement template (tool: Blank Template)</label>
      <param name="bk_movement_preset" type="optiongroup" appearance="combo" gui-text="Movement preset">
        <option value="nh35">Seiko NH35 / NH36</option>
        <option value="st36">Seagull ST36 / ST3600</option>
        <option value="custom">Custom (no template geometry)</option>
      </param>
      <separator/>
      <param name="bk_draw_outline" type="bool" gui-text="Draw outline">true</param>
      <param name="bk_outline_stroke_mm" type="float" min="0.01" max="2" precision="2" gui-text="Outline stroke (mm)">0.12</param>
      <param name="bk_compensate_outline" type="bool" gui-text="Compensate outline">true</param>
      <separator/>
      <param name="bk_draw_center_hole" type="bool" gui-text="Draw center hole">true</param>
      <param name="bk_draw_hand_holes" type="bool" gui-text="Draw hand holes">true</param>
      <param name="bk_draw_date_window" type="bool" gui-text="Draw date window (NH35)">true</param>
      <param name="bk_draw_subdial" type="bool" gui-text="Draw small seconds (ST36)">true</param>
      <param name="bk_draw_dial_feet" type="bool" gui-text="Draw dial feet (reference)">true</param>
      <separator/>
      <param name="bk_group_name" type="string" gui-text="Output group name">dial-template</param>
    </page>

    <!-- ========================= CLASSIC PATTERNS ========================= -->
    <page name="classic" gui-text="Classic Patterns">
      <label appearance="header">Classic / old-world patterns</label>
      <label>Guilloch&#233;, concentric rings, sunburst, crosshatch, plus multi-layer
auto-complex engraving. Set options below, then click Apply.</label>
      <separator/>
      <hbox>
      <vbox>
      <label appearance="header">Base</label>
      <param name="cp_dial_diameter_mm" type="float" min="10" max="60" precision="2" gui-text="Dial diameter (mm)">28.5</param>
      <param name="cp_draw_outline" type="bool" gui-text="Draw outline">true</param>
      <param name="cp_outline_stroke_mm" type="float" min="0.01" max="2" precision="2" gui-text="Outline stroke (mm)">0.12</param>
      <param name="cp_outline_compensate_stroke" type="bool" gui-text="Compensate outline for stroke">true</param>
      <separator/>
      <param name="cp_clip_to_circle" type="bool" gui-text="Clip pattern to circle">true</param>
      <param name="cp_inner_radius_mm" type="float" min="0" max="60" precision="2" gui-text="Inner radius (mm)">0.0</param>
      <separator/>
      <param name="cp_pattern_type" type="optiongroup" appearance="combo" gui-text="Pattern type">
        <option value="guilloche">Guilloch&#233; (rosette)</option>
        <option value="concentric">Concentric rings</option>
        <option value="sunburst">Sunburst</option>
        <option value="crosshatch">Crosshatch</option>
      </param>
      <param name="cp_stroke_mm" type="float" min="0.01" max="2" precision="2" gui-text="Stroke width (mm)">0.10</param>
      <param name="cp_stroke_color" type="string" gui-text="Stroke color (hex)">#000000</param>
      <param name="cp_stroke_opacity" type="float" min="0.0" max="1.0" precision="2" gui-text="Stroke opacity">0.35</param>
      <param name="cp_group_name" type="string" gui-text="Output group name">dial-pattern</param>
      <separator/>
      <label appearance="header">Guilloch&#233;</label>
      <param name="cp_lobes" type="int" min="2" max="200" gui-text="Lobes">12</param>
      <param name="cp_amplitude_mm" type="float" min="0" max="10" precision="2" gui-text="Amplitude (mm)">1.2</param>
      <param name="cp_points" type="int" min="200" max="20000" gui-text="Points (smoother = more)">1200</param>
      <param name="cp_guilloche_fill" type="bool" gui-text="Fill dial (guilloch&#233; field)">false</param>
      <param name="cp_band_spacing_mm" type="float" min="0.05" max="2" precision="2" gui-text="Band spacing (mm) (smaller = denser)">0.35</param>
      </vbox>
      <spacer/>
      <vbox>
      <label appearance="header">Concentric / Sunburst / Crosshatch</label>
      <param name="cp_ring_spacing_mm" type="float" min="0.05" max="5" precision="2" gui-text="Concentric ring spacing (mm)">0.6</param>
      <param name="cp_rays" type="int" min="4" max="2000" gui-text="Sunburst rays">120</param>
      <param name="cp_hatch_spacing_mm" type="float" min="0.05" max="5" precision="2" gui-text="Hatch spacing (mm)">0.7</param>
      <param name="cp_hatch_angle_deg" type="float" min="-90" max="90" precision="1" gui-text="Hatch angle (deg)">35.0</param>
      <param name="cp_hatch_double" type="bool" gui-text="Double hatch (adds 90&#176; cross)">true</param>
      <separator/>
      <label appearance="header">Auto complex (multi-layer engraving)</label>
      <param name="cp_auto_complex" type="bool" gui-text="Auto complex (multi-layer)">false</param>
      <param name="cp_complex_preset" type="optiongroup" appearance="combo" gui-text="Preset">
        <option value="rosette_stack">Rosette stack</option>
        <option value="breguet">Breguet-ish</option>
        <option value="modern">Modern</option>
        <option value="pocketwatch">Pocketwatch</option>
      </param>
      <param name="cp_layers" type="int" min="1" max="20" gui-text="Layers">4</param>
      <param name="cp_seed" type="int" min="0" max="999999" gui-text="Seed">1</param>
      <separator/>
      <param name="cp_rotate_jitter_deg" type="float" min="0" max="45" precision="2" gui-text="Rotation jitter (deg)">6.0</param>
      <param name="cp_opacity_decay" type="float" min="0.1" max="1.0" precision="2" gui-text="Opacity decay (per layer)">0.75</param>
      <param name="cp_stroke_decay" type="float" min="0.1" max="1.0" precision="2" gui-text="Stroke decay (per layer)">0.85</param>
      <param name="cp_lobe_jitter" type="int" min="0" max="100" gui-text="Lobe jitter">10</param>
      <param name="cp_amp_decay" type="float" min="0.1" max="1.0" precision="2" gui-text="Amplitude decay (per layer)">0.70</param>
      </vbox>
      </hbox>
    </page>

    <!-- ========================= ROSE ENGINE ========================= -->
    <page name="rose" gui-text="Rose Engine">
      <label appearance="header">Rose engine simulator (tool: Rose Engine)</label>
      <param name="re_preset_mode" type="optiongroup" appearance="combo" gui-text="Quick preset">
        <option value="custom">Use settings below (Custom)</option>
        <option value="default_25">Reset to Default (Rose)</option>
        <option value="small_cog">Small 10mm Cog</option>
      </param>
      <param name="re_preset" type="optiongroup" appearance="combo" gui-text="Wave shape">
        <option value="sine">Sine (Rosette)</option>
        <option value="square">Square (Engine Turned)</option>
        <option value="epicycloid">Epicycloid (Guilloch&#233;)</option>
      </param>
      <param name="re_lobes" type="int" min="1" max="200" gui-text="Lobes">18</param>
      <param name="re_amplitude" type="float" min="0.01" max="50.0" precision="2" gui-text="Wave depth (mm)">1.2</param>
      <param name="re_radius" type="float" min="0.1" max="500.0" precision="2" gui-text="Outer radius (mm)">12.5</param>
      <separator/>
      <label appearance="header">Multi-ring</label>
      <param name="re_multiply" type="bool" gui-text="Enable multi-ring">true</param>
      <param name="re_copies" type="int" min="1" max="100" gui-text="Rings">15</param>
      <param name="re_spacing" type="float" min="0.01" max="10.0" precision="2" gui-text="Inward spacing (mm)">0.4</param>
      <param name="re_twist" type="float" min="-45.0" max="45.0" precision="2" gui-text="Twist per ring (deg)">1.0</param>
      <param name="re_softness" type="float" min="0.01" max="1.0" precision="2" gui-text="Tool softness (square)">0.1</param>
      <param name="re_taper" type="float" min="0.0" max="1.0" precision="2" gui-text="Inward taper (0=None, 1=Full; 0=true rosette)">0.0</param>
      <param name="re_group_name" type="string" gui-text="Output group name">rose-engine</param>
    </page>

    <!-- ========================= PERLAGE ========================= -->
    <page name="perlage" gui-text="Perlage">
      <label appearance="header">Perlage / spots (tool: Perlage)</label>
      <param name="pg_pattern" type="optiongroup" appearance="combo" gui-text="Pattern type">
        <option value="staggered">Staggered grid</option>
        <option value="grid">Grid</option>
        <option value="spiral">Spiral</option>
        <option value="radial">Radial rings</option>
      </param>
      <param name="pg_outer_diameter" type="float" min="0.1" max="5000" precision="3" gui-text="Outer pattern diameter (mm)">29.0</param>
      <param name="pg_center_hole_diameter" type="float" min="0.0" max="5000" precision="3" gui-text="Center exclusion diameter (mm)">0.0</param>
      <param name="pg_spot_diameter" type="float" min="0.01" max="100" precision="3" gui-text="Visual spot diameter (mm)">0.35</param>
      <param name="pg_spacing_x" type="float" min="0.01" max="100" precision="3" gui-text="Spacing X (mm)">0.75</param>
      <param name="pg_spacing_y" type="float" min="0.01" max="100" precision="3" gui-text="Spacing Y (mm)">0.75</param>
      <param name="pg_rotation_deg" type="float" min="-360" max="360" precision="2" gui-text="Rotation (degrees)">0.0</param>
      <separator/>
      <label appearance="header">Variation</label>
      <param name="pg_jitter_xy" type="float" min="0.0" max="10.0" precision="3" gui-text="XY jitter (mm)">0.0</param>
      <param name="pg_skip_percent" type="float" min="0.0" max="100.0" precision="2" gui-text="Skip percent">0.0</param>
      <param name="pg_seed" type="int" min="0" max="999999" gui-text="Random seed">7</param>
      <separator/>
      <label appearance="header">Guides</label>
      <param name="pg_draw_guides" type="bool" gui-text="Draw guide circles">true</param>
      <param name="pg_guide_stroke_width" type="float" min="0.01" max="10" precision="3" gui-text="Guide stroke width (mm)">0.05</param>
      <param name="pg_group_name" type="string" gui-text="Output group name">perlage</param>
    </page>

    <!-- ========================= MODERN PATTERNS ========================= -->
    <page name="modern" gui-text="Modern Patterns">
      <label appearance="header">Modern / new-world patterns</label>
      <label>Mondrian blocks, 60s op-art waves, spiral stripes, paper and linen
textures. Set options below, then click Apply.</label>
      <separator/>
      <hbox>
      <vbox>
      <label appearance="header">Base</label>
      <hbox>
        <param name="mp_dial_diameter_mm" type="float" min="10" max="60" precision="2" gui-text="Dial diameter (mm)">28.50</param>
        <param name="mp_inner_radius_mm" type="float" min="0" max="30" precision="2" gui-text="Inner radius (mm)">0.00</param>
      </hbox>
      <hbox>
        <param name="mp_clip_to_circle" type="bool" gui-text="Clip to dial circle">true</param>
        <param name="mp_draw_outline" type="bool" gui-text="Draw outline">false</param>
      </hbox>
      <param name="mp_outline_stroke_mm" type="float" min="0.01" max="2" precision="3" gui-text="Outline stroke (mm)">0.12</param>
      <separator/>
      <param name="mp_pattern_type" type="optiongroup" appearance="combo" gui-text="Pattern">
        <option value="mondrian">Mondrian Blocks</option>
        <option value="op_waves">60s Op Art Waves</option>
        <option value="spiral_stripes">Psychedelic Spiral Stripes</option>
        <option value="paper_texture">Paper Texture</option>
        <option value="linen_texture">Linen Texture</option>
      </param>
      <param name="mp_seed" type="int" min="0" max="999999" gui-text="Seed">1</param>
      <separator/>
      <label appearance="header">Stroke (Op Art + Spiral)</label>
      <hbox>
        <param name="mp_stroke_mm" type="float" min="0.01" max="2" precision="3" gui-text="Stroke width (mm)">0.10</param>
        <param name="mp_stroke_opacity" type="float" min="0" max="1" precision="3" gui-text="Stroke opacity">0.35</param>
      </hbox>
      <param name="mp_stroke_color" type="string" gui-text="Stroke color (hex)">#000000</param>
      <param name="mp_group_name" type="string" gui-text="Output group name">modern-dial-pattern</param>
      <separator/>
      <label appearance="header">Mondrian</label>
      <hbox>
        <param name="mp_mondrian_density" type="float" min="0.15" max="1.50" precision="2" gui-text="Density">0.60</param>
        <param name="mp_mondrian_line_mm" type="float" min="0.05" max="2.00" precision="3" gui-text="Grid line width (mm)">0.35</param>
      </hbox>
      <hbox>
        <param name="mp_mondrian_palette" type="optiongroup" appearance="combo" gui-text="Palette">
          <option value="classic">Classic (primary + white)</option>
          <option value="pastel">Pastel</option>
          <option value="vibrant">Vibrant</option>
        </param>
        <param name="mp_mondrian_fill_opacity" type="float" min="0" max="1" precision="2" gui-text="Fill opacity">1.00</param>
      </hbox>
      <separator/>
      <label appearance="header">60s Op Art</label>
      <hbox>
        <param name="mp_op_line_spacing_mm" type="float" min="0.08" max="2.00" precision="3" gui-text="Line spacing (mm)">0.35</param>
        <param name="mp_op_warp_strength_mm" type="float" min="0.00" max="5.00" precision="3" gui-text="Warp strength (mm)">0.70</param>
      </hbox>
      <hbox>
        <param name="mp_op_warp_frequency" type="float" min="0.50" max="20.00" precision="2" gui-text="Warp frequency">6.00</param>
        <param name="mp_op_rotate_deg" type="float" min="-180" max="180" precision="1" gui-text="Rotate (deg)">0.0</param>
      </hbox>
      </vbox>
      <spacer/>
      <vbox>
      <label appearance="header">Spiral</label>
      <hbox>
        <param name="mp_spiral_turns" type="float" min="0.5" max="30" precision="2" gui-text="Turns">5.00</param>
        <param name="mp_spiral_stripe_width_mm" type="float" min="0.05" max="2.00" precision="3" gui-text="Stripe width (mm)">0.35</param>
      </hbox>
      <separator/>
      <label appearance="header">Paper texture</label>
      <hbox>
        <param name="mp_paper_speckle_density" type="float" min="0" max="80" precision="1" gui-text="Speckle density">18.0</param>
        <param name="mp_paper_speckle_radius_mm" type="float" min="0.01" max="0.30" precision="3" gui-text="Speckle radius (mm)">0.060</param>
      </hbox>
      <hbox>
        <param name="mp_paper_fiber_count" type="int" min="0" max="6000" gui-text="Fiber count">1200</param>
        <param name="mp_paper_fiber_length_mm" type="float" min="0.05" max="3.00" precision="2" gui-text="Fiber length (mm)">0.55</param>
      </hbox>
      <hbox>
        <param name="mp_paper_fiber_jitter_mm" type="float" min="0.00" max="1.00" precision="2" gui-text="Fiber jitter (mm)">0.12</param>
        <param name="mp_paper_opacity" type="float" min="0" max="1" precision="3" gui-text="Opacity">0.10</param>
      </hbox>
      <param name="mp_paper_color" type="string" gui-text="Ink color (hex)">#000000</param>
      <separator/>
      <label appearance="header">Linen / weave texture</label>
      <hbox>
        <param name="mp_linen_thread_spacing_mm" type="float" min="0.05" max="2.00" precision="2" gui-text="Thread spacing (mm)">0.35</param>
        <param name="mp_linen_waviness_mm" type="float" min="0.00" max="1.50" precision="2" gui-text="Waviness (mm)">0.10</param>
      </hbox>
      <hbox>
        <param name="mp_linen_waviness_freq" type="float" min="0.5" max="30" precision="1" gui-text="Waviness frequency">7.0</param>
        <param name="mp_linen_rotate_deg" type="float" min="-180" max="180" precision="1" gui-text="Rotate (deg)">0.0</param>
      </hbox>
      <param name="mp_linen_color" type="string" gui-text="Ink color (hex)">#000000</param>
      <param name="mp_linen_opacity" type="float" min="0" max="1" precision="3" gui-text="Opacity">0.18</param>
      </vbox>
      </hbox>
    </page>

    <!-- ========================= SHAPES ========================= -->
    <page name="shapes" gui-text="Shapes">
      <label appearance="header">Shapes &#8212; circle, rectangle, annulus</label>
      <label>Add geometric shapes to your dial. Select a shape type and configure
its parameters, then click Apply. All shapes center on the document center.</label>
      <separator/>
      <hbox>
      <vbox>
      <param name="sh_shape_type" type="optiongroup" appearance="combo" gui-text="Shape type">
        <option value="circle">Circle</option>
        <option value="rectangle">Rectangle</option>
        <option value="annulus">Annulus (ring)</option>
      </param>
      <separator/>
      <label appearance="header">Stroke</label>
      <param name="sh_stroke_color" type="string" gui-text="Stroke color (hex)">#000000</param>
      <param name="sh_stroke_mm" type="float" min="0.01" max="5" precision="3" gui-text="Stroke width (mm)">0.12</param>
      <separator/>
      <label appearance="header">Fill</label>
      <param name="sh_draw_fill" type="bool" gui-text="Draw fill">false</param>
      <param name="sh_fill_color" type="string" gui-text="Fill color (hex)">#ffffff</param>
      <param name="sh_fill_opacity" type="float" min="0" max="1" precision="2" gui-text="Fill opacity">1.0</param>
      <separator/>
      <param name="sh_group_name" type="string" gui-text="Output group name">dial-shape</param>
      </vbox>
      <spacer/>
      <vbox>
      <label appearance="header">Circle</label>
      <param name="sh_circle_diameter_mm" type="float" min="0.1" max="500" precision="2" gui-text="Diameter (mm)">28.5</param>
      <param name="sh_circle_offset_x_mm" type="float" min="-200" max="200" precision="2" gui-text="X offset from center (mm)">0.0</param>
      <param name="sh_circle_offset_y_mm" type="float" min="-200" max="200" precision="2" gui-text="Y offset from center (mm)">0.0</param>
      <separator/>
      <label appearance="header">Rectangle</label>
      <param name="sh_rect_width_mm" type="float" min="0.1" max="500" precision="2" gui-text="Width (mm)">30.0</param>
      <param name="sh_rect_height_mm" type="float" min="0.1" max="500" precision="2" gui-text="Height (mm)">30.0</param>
      <param name="sh_rect_corner_radius_mm" type="float" min="0" max="100" precision="2" gui-text="Corner radius (mm)">0.0</param>
      <param name="sh_rect_offset_x_mm" type="float" min="-200" max="200" precision="2" gui-text="X offset from center (mm)">0.0</param>
      <param name="sh_rect_offset_y_mm" type="float" min="-200" max="200" precision="2" gui-text="Y offset from center (mm)">0.0</param>
      <param name="sh_rect_rotation_deg" type="float" min="-180" max="180" precision="1" gui-text="Rotation (deg)">0.0</param>
      <separator/>
      <label appearance="header">Annulus (ring)</label>
      <param name="sh_annulus_outer_diameter_mm" type="float" min="0.1" max="500" precision="2" gui-text="Outer diameter (mm)">28.5</param>
      <param name="sh_annulus_inner_diameter_mm" type="float" min="0.1" max="500" precision="2" gui-text="Inner diameter (mm)">22.0</param>
      <label>Enable Fill above to color the ring area (annulus only).</label>
      </vbox>
      </hbox>
    </page>

  </param>

  <effect>
    <object-type>all</object-type>
    <effects-menu/>
  </effect>

  <script>
    <command location="inx" interpreter="python">watch_dial_tools.py</command>
  </script>
</inkscape-extension>
