<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Watch Dial Tools</name>
  <id>com.bjj.watchdial.tools</id>

  <param name="ui" type="notebook">

    <!-- Each tab below is one tool. Whatever tab is open when you click Apply
         (or with Live preview enabled) is the tool that runs. No separate
         selector: the open tab IS the active tool. Every tool centers on the
         document center, so generated layers stack perfectly concentric. -->

    <!-- ============================= DIAL ============================= -->
    <page name="dial" gui-text="Dial">
      <label appearance="header">Dial &#8212; outline, center, numerals, markers</label>
      <label>Draws the dial outline, center hole, numerals, hour markers and
minute ticks. Set options below, then click Apply (this tab runs the Dial tool).</label>
      <separator/>
      <hbox>
      <vbox>
      <label appearance="header">Outline &amp; center</label>
      <param name="wd_dial_diameter_mm" type="float" min="10" max="60" precision="2" gui-text="Dial diameter (mm)">28.5</param>
      <param name="wd_draw_dial_outline" type="bool" gui-text="Draw dial outline">true</param>
      <param name="wd_dial_outline_stroke_mm" type="float" min="0.01" max="2" precision="2" gui-text="Outline stroke (mm)">0.12</param>
      <param name="wd_outline_compensate_stroke" type="bool" gui-text="Compensate outline for stroke (keeps outer diameter exact)">true</param>
      <separator/>
      <param name="wd_draw_center_hole" type="bool" gui-text="Draw center hole">true</param>
      <param name="wd_center_hole_mm" type="float" min="0.1" max="10" precision="2" gui-text="Center hole diameter (mm)">1.5</param>
      <separator/>
      <param name="wd_start_angle_deg" type="float" min="-360" max="360" precision="2" gui-text="Start angle (deg, 0=12 o'clock)">0</param>
      <param name="wd_clockwise" type="bool" gui-text="Clockwise">true</param>
      <param name="wd_group_name" type="string" gui-text="Output group name">watch-dial</param>
      <separator/>
      <label appearance="header">Numerals</label>
      <param name="wd_text_mode" type="optiongroup" appearance="combo" gui-text="Text mode">
        <option value="arabic">Arabic (1&#8211;12)</option>
        <option value="roman">Roman (I&#8211;XII)</option>
        <option value="custom">Custom (CSV)</option>
      </param>
      <param name="wd_labels_csv" type="string" gui-text="Custom labels (CSV)"></param>
      <param name="wd_roman_four_style" type="optiongroup" appearance="combo" gui-text="Roman 4 style">
        <option value="IV">IV</option>
        <option value="IIII">IIII</option>
      </param>
      <param name="wd_omit_three" type="bool" gui-text="Omit 3 for date window">false</param>
      <separator/>
      <param name="wd_text_radius_mm" type="float" min="0" max="60" precision="2" gui-text="Text radius (mm)">11.5</param>
      <param name="wd_text_radial_offset_mm" type="float" min="-10" max="10" precision="2" gui-text="Text radial offset / fine-tune (mm)">0</param>
      <param name="wd_text_angle_offset_deg" type="float" min="-30" max="30" precision="2" gui-text="Text angle offset (deg)">0</param>
      </vbox>
      <spacer/>
      <vbox>
      <label appearance="header">Font</label>
      <param name="wd_font_preset" type="optiongroup" appearance="combo" gui-text="Font (installed)">
        <option value="Agency FB">Agency FB</option>
        <option value="Algerian">Algerian</option>
        <option value="AlienCaret">AlienCaret</option>
        <option value="Anton">Anton</option>
        <option value="Arial">Arial</option>
        <option value="Arial Black">Arial Black</option>
        <option value="Arial Narrow">Arial Narrow</option>
        <option value="Arial Rounded MT Bold">Arial Rounded MT Bold</option>
        <option value="Bahnschrift">Bahnschrift</option>
        <option value="Barlow Condensed">Barlow Condensed</option>
        <option value="Barlow Condensed Black">Barlow Condensed Black</option>
        <option value="Barlow Condensed ExtraBold">Barlow Condensed ExtraBold</option>
        <option value="Barlow Condensed ExtraLight">Barlow Condensed ExtraLight</option>
        <option value="Barlow Condensed Light">Barlow Condensed Light</option>
        <option value="Barlow Condensed Medium">Barlow Condensed Medium</option>
        <option value="Barlow Condensed SemiBold">Barlow Condensed SemiBold</option>
        <option value="Barlow Condensed Thin">Barlow Condensed Thin</option>
        <option value="Baskerville Old Face">Baskerville Old Face</option>
        <option value="Bauhaus 93">Bauhaus 93</option>
        <option value="Bell MT">Bell MT</option>
        <option value="Berlin Sans FB">Berlin Sans FB</option>
        <option value="Berlin Sans FB Demi">Berlin Sans FB Demi</option>
        <option value="Bernard MT Condensed">Bernard MT Condensed</option>
